meta
{
    title: "Spanish name abbreviations and accent marks";
    version: "0.1";
    description: "Random validation rules focused on the Spanish that improve JOSM life.";
    author: "whammo";
    baselanguage: "en";
    min-josm-version: 14481;
    link: "https://github.com/whubsch/custom-josm-rules";
}

*[inside("AR")],
*[inside("BO")],
*[inside("CL")],
*[inside("CO")],
*[inside("CR")],
*[inside("CU")],
*[inside("DO")],
*[inside("EC")],
*[inside("ES")],
*[inside("GQ")],
*[inside("GT")],
*[inside("HN")],
*[inside("MX")],
*[inside("NI")],
*[inside("PA")],
*[inside("PE")],
*[inside("PY")],
*[inside("SV")],
*[inside("UY")],
*[inside("VE")] {
  set spanish;
}

*["amenity"="bicycle_rental"].spanish,
*["highway"="bus_stop"].spanish {
  set exempt;
}

*["name"=~/\bSta\.?\b/].spanish!.exempt {
  group: "Common abbreviation used in name (Spanish)";
  throwWarning: "Santa";
  fixAdd: concat("name=", replace(replace(tag("name"), "Sta.", "Santa"), "Sta ", "Santa "));
}
*["name"=~/\bDptal\.?\b/].spanish!.exempt {
  group: "Common abbreviation used in name (Spanish)";
  throwWarning: "Departamental";
  fixAdd: concat("name=", replace(replace(tag("name"), "Dptal.", "Departamental"), "Dptal ", "Departamental "));
}
